# Copy to .env and fill in real values. NEVER commit .env.

# OpenAI — LLM extraction/synthesis + embeddings
OPENAI_API_KEY=

# Model names (keep configurable; do not hardcode in source)
OPENAI_LLM_MODEL=gpt-4o
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Live data API clients (src/tools). Public APIs — keys often optional.
# ClinicalTrials.gov v2 API needs no key. Set a contact UA per FDA etiquette.
CLINICALTRIALS_API_BASE=https://clinicaltrials.gov/api/v2
FDA_API_BASE=https://api.fda.gov
# OPENFDA_API_KEY=        # optional; raises openFDA rate limits if set
